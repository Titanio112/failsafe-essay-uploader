# Variáveis de ambiente para automação de redações
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env (está no .gitignore)

# Conta de teste (modo --modo-teste)
ESQUEMA_EMAIL_TESTE=<definir-no-.env>
ESQUEMA_SENHA_TESTE=<definir-no-.env>

# Senha padrão para contas de produção (alunos da planilha)
ESQUEMA_SENHA_PADRAO=<definir-no-.env>