# Variáveis de ambiente para automação de redações
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env (está no .gitignore)

# Conta de teste (modo --modo-teste e --ensaio)
ESQUEMA_EMAIL_TESTE=<definir-no-.env>
ESQUEMA_SENHA_TESTE=<definir-no-.env>

# Alunos: cada um usa a senha dele, na coluna Senha do alunos.csv da turma
# (Redações plataforma/<Escola>/<Turma>/alunos.csv). Não existe senha padrão.
